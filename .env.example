# Copy to .env and fill in real values. Never commit the populated .env file.

POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app
DATABASE_URL=postgresql+asyncpg://app:changeme@postgres:5432/app

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=changeme-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

RECAPTCHA_SITE_KEY=changeme
RECAPTCHA_SECRET_KEY=changeme
LOGIN_FAILURE_THRESHOLD=3

# 32-byte urlsafe-base64-encoded Fernet key. Generate with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=changeme-generate-a-real-32-byte-fernet-key
